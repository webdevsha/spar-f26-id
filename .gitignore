# repo-local artifacts (never commit a local token file)
.env
.env.*
!.env.example

# generated dashboard output is committed on purpose (nightly snapshot);
# local scratch is not
scratch/
*.log
.DS_Store

# never commit credentials
*.pem
*.key
service-account*.json

# python bytecode
__pycache__/
*.pyc

# per-deploy page copies staged by the deploy workflow; dist/index.html stays tracked
# as the committed snapshot
dist/build/

# Third-party documents: cited in docs/REFERENCE-LIBRARY.md, never committed (public repo)
docs/Data feed/
docs/2026-08-Macroeconomic-Consequences-of-AI-Redux.pdf
docs/SPAR_Model_Proposal_V1 (1).pdf
docs/The Empty Chair - SPAR Indonesia country report and policy brief_draft.pdf
