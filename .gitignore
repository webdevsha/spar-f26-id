# repo-local artifacts (never commit a local token file)
.env
.env.*
!.env.example

# generated dashboard output is committed on purpose (nightly snapshot);
# local scratch is not
scratch/
*.log
.DS_Store

# never commit credentials
*.pem
*.key
service-account*.json

# python bytecode
__pycache__/
*.pyc

# per-deploy page copies staged by the deploy workflow; dist/index.html stays tracked
# as the committed snapshot
dist/build/

# Source documents ARE tracked (public disclosures, committed so the analysis pipeline can read them)
# - see docs/REFERENCE-LIBRARY.md. Nothing under docs/ is ignored; add large binaries deliberately.
